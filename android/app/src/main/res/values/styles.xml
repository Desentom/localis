<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Стиль окна запуска. Тёмный фон обязателен: приложение тёмное,
      иначе при холодном старте человек видит белую вспышку — на первый
      взгляд это выглядит как «приложение из 2010 года».
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Тема после старта Flutter — прозрачная, рисует только Dart. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
